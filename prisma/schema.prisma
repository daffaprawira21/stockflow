generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  orders             Order[]
  stockMovements     StockMovement[]
  orderStatusHistory OrderStatusHistory[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("sessions")
}

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  sku         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?
  price       Decimal  @db.Decimal(15, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([isActive])
  @@index([name])
  @@map("products")
}

model Order {
  id          String    @id @default(uuid(7)) @db.Uuid
  orderNumber String    @unique @map("order_number") @db.VarChar(50)
  status      String    @db.VarChar(20)
  totalAmount Decimal   @map("total_amount") @db.Decimal(15, 2)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdByUser     User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items             OrderItem[]
  stockMovements    StockMovement[]
  statusHistory     OrderStatusHistory[]
  idempotencyRecord IdempotencyRecord?

  @@index([status, createdAt])
  @@index([createdBy, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(15, 2)
  subtotal  Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model StockMovement {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  performedBy    String   @map("performed_by") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  movementType   String   @map("movement_type") @db.VarChar(30)
  quantityDelta  Int      @map("quantity_delta")
  quantityBefore Int      @map("quantity_before")
  quantityAfter  Int      @map("quantity_after")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  performedByUser User    @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  order           Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId, movementType])
  @@index([productId, createdAt])
  @@index([orderId])
  @@index([performedBy, createdAt])
  @@map("stock_movements")
}

model OrderStatusHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  changedBy  String   @map("changed_by") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String   @map("to_status") @db.VarChar(20)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order         Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedByUser User  @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model IdempotencyRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  operation      String   @db.VarChar(50)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  resourceId     String   @unique @map("resource_id") @db.Uuid
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, idempotencyKey])
  @@map("idempotency_records")
}
