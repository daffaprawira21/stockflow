# PostgreSQL connection used by the application and the Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow?schema=public"

# Dedicated database for integration tests. Never point this at development or production data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow_test?schema=public"

# Seeded administrator account. The password must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-local-env"

# Session cookie name. Defaults to stockflow_session when omitted.
SESSION_COOKIE_NAME="stockflow_session"

# Comma-separated list of allowed origins for state-changing requests.
# When omitted, the request origin is used.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Set to true only to allow seeding when NODE_ENV=production.
ALLOW_SEED="false"
